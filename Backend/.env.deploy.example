# =============================================================================
# Environnement de DEPLOIEMENT du backend (docker-compose.proxy.yml)
# Copier en .env puis remplacer les secrets par des valeurs de production.
#   cp .env.deploy.example .env
# =============================================================================

# --- API ---
API_PREFIX=/api
# CORS : doit inclure l'origine du frontend servi par le proxy.
CORS_ORIGINS=https://admin-console.oscar-bot.com

# --- PostgreSQL (utilise par docker-compose.proxy.yml) ---
POSTGRES_USER=oscar
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=oscar_admin
# DATABASE_URL est injectee par la compose (service "db"). Ne pas la mettre ici.

# --- Auth ---
SECRET_KEY=change-me-in-prod-please-32-chars-min
ACCESS_TTL_MINUTES=60
REFRESH_TTL_DAYS=14

# --- LiveKit (emission jetons robot/operateur) ---
LIVEKIT_URL=ws://oscar-livekit-server:7880
LIVEKIT_API_KEY=change-me-livekit-key
LIVEKIT_API_SECRET=change-me-livekit-secret

# --- Bootstrap admin ---
ADMIN_EMAIL=admin@oscar-bot.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Super Admin

# --- Seed (mettre a false pour une base vierge en prod) ---
SEED_DEMO=false

# --- Stockage modeles IA ---
MODEL_STORAGE_DIR=/app/storage/models
MODEL_MAX_UPLOAD_MB=512
# Secret partagé uniquement avec les perception workers. Générer au moins 32 octets.
PERCEPTION_WORKER_API_KEY=change-me-random-32-byte-worker-key

# --- Keycloak / OIDC (IAM) - derriere le proxy nginx/TLS ---
# AUTH_MODE=legacy en Lot 0 (cutover keycloak lors d'un lot ulterieur).
AUTH_MODE=legacy
OIDC_ISSUER=https://auth.oscar-bot.com/realms/oscar
OIDC_AUDIENCE=oscar-backend
OIDC_JWKS_URL=
KEYCLOAK_BASE_URL=https://auth.oscar-bot.com
KEYCLOAK_REALM=oscar
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-admin-password
KEYCLOAK_BACKEND_CLIENT_ID=oscar-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me-strong-backend-secret
# Base PostgreSQL DEDIEE de Keycloak (jamais oscar_admin).
KC_DB_USER=keycloak
KC_DB_PASSWORD=change-me-strong-kc-db-password
KC_DB_NAME=keycloak
# Mode proxy (TLS termine en amont) + hostname public de Keycloak.
KC_PROXY=edge
KC_HOSTNAME=auth.oscar-bot.com
# Redirect URIs / origins du SPA (resolus a l'import du realm).
OSCAR_FRONTEND_REDIRECT_URIS=https://admin-console.oscar-bot.com/*
OSCAR_FRONTEND_WEB_ORIGINS=https://admin-console.oscar-bot.com
