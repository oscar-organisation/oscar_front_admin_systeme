# --- API ---
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg2://oscar:oscar@localhost:5432/oscar_admin

# --- Auth ---
SECRET_KEY=change-me-in-prod-please-32-chars-min
ACCESS_TTL_MINUTES=60
REFRESH_TTL_DAYS=14

# --- LiveKit (émission jetons robot/opérateur) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=oscar_prod_key
LIVEKIT_API_SECRET=oscar_super_secret_prod_key

# --- Bootstrap admin ---
ADMIN_EMAIL=admin@oscar.fr
ADMIN_PASSWORD=oscar-admin
ADMIN_NAME=Super Admin

# --- Stockage modèles IA ---
MODEL_STORAGE_DIR=./storage/models

# --- Keycloak / OIDC (IAM) - Lot 0 : additif, non branché sur les routes ---
# AUTH_MODE=legacy garde l'auth JWT HS256 maison (rien de cassé en Lot 0).
AUTH_MODE=legacy
OIDC_ISSUER=http://localhost:8080/realms/oscar
OIDC_AUDIENCE=oscar-backend
# OIDC_JWKS_URL : laisser vide => dérivé de l'issuer (.../protocol/openid-connect/certs)
OIDC_JWKS_URL=
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=oscar
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_BACKEND_CLIENT_ID=oscar-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me-in-env
# Base PostgreSQL DEDIEE de Keycloak (jamais oscar_admin) - utilisée par docker-compose.
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak
KC_DB_NAME=keycloak
# Redirect URIs / origins du SPA (résolus à l'import du realm).
OSCAR_FRONTEND_REDIRECT_URIS=http://localhost:5173/*
OSCAR_FRONTEND_WEB_ORIGINS=http://localhost:5173
